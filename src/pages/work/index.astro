---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { getProjects, isWorkbench } from '../../lib/projects';

const projects = await getProjects();

const caseStudies = projects.filter((p) => p.data.category === 'work');
const made = projects.filter((p) => p.data.category !== 'work' && !isWorkbench(p));
const workbench = projects.filter((p) => p.data.category !== 'work' && isWorkbench(p));

const groups = [
  {
    id: 'case-studies',
    title: 'Day-job case studies',
    blurb: 'Work I did for employers: the problem, my part in it, and how it turned out.',
    items: caseStudies,
  },
  {
    id: 'made',
    title: 'Things I’ve made',
    blurb: 'Side projects that made it out the door: generators, games, books and more.',
    items: made,
  },
  {
    id: 'workbench',
    title: 'On the workbench',
    blurb: 'Unfinished and unpublished. Still worth a look.',
    items: workbench,
  },
].filter((g) => g.items.length > 0);
---

<Base title="Work" description="Case studies, side projects, generators, games and books by Aaron Rierson-Lott.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Work</p>
      <h1>Things I’ve built</h1>
      <p class="lede">
        {/* TODO: tweak this intro */}
        A mix of day-job case studies and the side projects I make for fun. Different scales, same habit:
        take something fiddly and make it simple to use.
      </p>
      <nav aria-label="Jump to section" class="jump">
        {groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
      </nav>
    </div>
  </section>

  {
    groups.map((group) => (
      <section class="section" id={group.id} aria-labelledby={`${group.id}-heading`}>
        <div class="container">
          <div class="section-head">
            <h2 id={`${group.id}-heading`}>{group.title}</h2>
            <p>{group.blurb}</p>
          </div>
          <div class="grid">
            {group.items.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <ContactBand />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-m);
    font-weight: 700;
  }
</style>
