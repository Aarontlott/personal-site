---
/**
 * Copy-to-clipboard for email links.
 *
 * Any link with `data-copy-email` copies its address instead of opening
 * the mail app, then shows a speech bubble above the link that was clicked.
 * If JavaScript is off, or the copy fails, the link still works as a
 * normal mailto: link.
 *
 * Usage: <a href="mailto:you@example.com" data-copy-email>Copy my email</a>
 * Included once, in the Base layout.
 */
---

<div class="copy-bubble" role="status" aria-live="polite" data-copy-bubble></div>

<script>
  const bubble = document.querySelector<HTMLElement>('[data-copy-bubble]');
  const GAP = 14; // px between the bubble's tail and the link
  const EDGE = 12; // px to keep clear of the window edges
  let hideTimer: number | undefined;

  /** Position the bubble centred above `anchor`, kept inside the window, tail pointing at the anchor. */
  function placeAbove(anchor: HTMLElement) {
    if (!bubble) return;
    const rect = anchor.getBoundingClientRect();
    const anchorCentre = rect.left + rect.width / 2;
    const half = bubble.offsetWidth / 2;
    const centre = Math.min(
      Math.max(anchorCentre, EDGE + half),
      document.documentElement.clientWidth - EDGE - half,
    );

    bubble.style.left = `${centre + window.scrollX}px`;
    bubble.style.top = `${rect.top + window.scrollY - GAP}px`;
    // Shift the tail if the bubble had to move to stay on screen.
    bubble.style.setProperty('--tail-offset', `${anchorCentre - centre}px`);
  }

  function showBubble(anchor: HTMLElement, message: string) {
    if (!bubble) return;
    bubble.textContent = message;
    placeAbove(anchor);
    bubble.classList.add('is-visible');
    window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => bubble.classList.remove('is-visible'), 5200);
  }

  document.addEventListener('click', async (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-copy-email]');
    if (!link) return;

    // Let modifier-clicks (new tab, etc.) and browsers without the Clipboard API behave normally.
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (!navigator.clipboard?.writeText) return;

    event.preventDefault();
    const email = link.href.replace(/^mailto:/, '').split('?')[0];

    try {
      await navigator.clipboard.writeText(email);
      showBubble(link, `There you go, '${email}' is on your clipboard`);
    } catch {
      // Copy was blocked: fall back to opening the mail app.
      window.location.href = link.href;
    }
  });
</script>

<style>
  /* A square-ish speech bubble that sits above whatever was clicked.
     Paper background + navy border reads clearly on both the paper
     pages and the navy "Let's talk" band. */
  .copy-bubble {
    --tail-size: 12px;
    --tail-offset: 0px;
    position: absolute;
    z-index: 20;
    max-width: min(22rem, calc(100vw - 24px));
    padding: 0.7em 1em;
    border: 2px solid var(--navy);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--navy);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    /* box-shadow: 4px 4px 0 var(--accent); */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* Anchored by its bottom-centre; JS sets left/top */
    transform: translate(-50%, calc(-100% + 6px));
    transition: opacity 160ms ease, transform 160ms ease, visibility 0s linear 160ms;
  }
  .copy-bubble.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -100%);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  /* The tail: a rotated square sharing the bubble's border */
  .copy-bubble::after {
    content: '';
    position: absolute;
    left: calc(50% + var(--tail-offset));
    bottom: calc(var(--tail-size) / -2 - 1px);
    width: var(--tail-size);
    height: var(--tail-size);
    background: var(--surface);
    border-right: 2px solid var(--navy);
    border-bottom: 2px solid var(--navy);
    transform: translateX(-50%) rotate(45deg);
  }
</style>
