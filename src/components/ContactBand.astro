---
import { site } from '../data/site';
const linkedin = site.links.find((l) => l.label === 'LinkedIn');
---

<section class="section section--band" aria-labelledby="contact-band-heading">
  <div class="container contact-band">
    <div>
      <h2 id="contact-band-heading">Let’s talk</h2>
      <p class="lede">
      The work I like best sits between design and engineering, close to the people who use it. I’m open to roles like that so, if yours is one, I’d love to hear from you.
      </p>
    </div>
    <div class="actions">
      <a class="button button--primary" href={`mailto:${site.email}`}>Email me</a>
      {linkedin && <a class="button" href={linkedin.url} rel="me noopener">LinkedIn</a>}
      {site.cv && <a class="button" href={site.cv}>Download CV</a>}
    </div>
  </div>
</section>

<style>
  .contact-band {
    display: grid;
    gap: var(--space-m);
    align-items: end;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .contact-band .lede {
    margin: 0;
  }
</style>
