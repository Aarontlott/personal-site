---
import type { Project } from '../lib/projects';
import { categoryLabels, statusLabels } from '../data/site';

interface Props {
  project: Project;
  /** Heading level, so cards nest correctly under section headings. */
  as?: 'h2' | 'h3';
}

const { project, as: Heading = 'h3' } = Astro.props;
const { title, summary, category, status, year, stack } = project.data;
const href = `/work/${project.id}/`;
---

<article class="project-card card">
  <p class="project-card__meta">
    <span>{categoryLabels[category]}</span>
    {year && <span aria-hidden="true">·</span>}
    {year && <span>{year}</span>}
    {status !== 'shipped' && <span class={`badge badge--${status}`}>{statusLabels[status]}</span>}
  </p>
  <Heading class="project-card__title">
    <a href={href}>{title}</a>
  </Heading>
  <p class="project-card__summary">{summary}</p>
  {
    stack.length > 0 && (
      <ul role="list" class="tags" aria-label="Built with">
        {stack.map((tech) => (
          <li class="tag">{tech}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
  }
  /* Whole card is clickable via the title link */
  .project-card:hover {
    transform: translateY(-3px);
    border-color: var(--space-indigo);
    box-shadow: 6px 6px 0 var(--space-indigo);
  }
  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .project-card__meta .badge {
    margin-left: auto;
  }
  .project-card__title {
    font-size: var(--step-1);
    margin: 0;
  }
  .project-card__title a {
    color: var(--space-indigo);
    text-decoration: none;
  }
  .project-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .project-card__title a:focus-visible {
    outline: none;
  }
  .project-card:has(a:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  .project-card__summary {
    margin: 0 0 var(--space-xs);
    color: var(--text-muted);
    flex: 1;
  }
</style>
