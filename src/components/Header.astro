---
import { nav } from '../data/site';

const path = Astro.url.pathname;
// Home ("/") only matches the home page itself; every path starts with "/".
// Other items also match their sub-pages, e.g. Work for /work/inkling/.
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label="Aaron Rierson-Lott, home">
      <span class="wordmark__prompt" aria-hidden="true">~$</span>
      aaron<span class="wordmark__dot">.</span>rierson-lott
    </a>
    <nav aria-label="Main">
      <ul role="list" class="site-nav">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5; /* above page content; below the skip link and copy bubble */
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-s);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--space-indigo);
    text-decoration: none;
  }
  .wordmark__prompt {
    font-family: var(--font-mono);
    color: var(--cerulean);
    margin-right: 0.3em;
  }
  .wordmark__dot {
    color: var(--accent-strong);
  }
  .site-nav {
    display: flex;
    gap: var(--space-m);
  }
  .site-nav a {
    color: var(--space-indigo);
    text-decoration: none;
    font-weight: 700;
    padding-block: 0.25em;
    border-bottom: 3px solid transparent;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
  }

  @media (--xs-down) {
     .site-header__inner {
      gap: 1.5rem;
    }
  }
</style>
