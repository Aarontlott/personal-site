---
/**
 * The old site's `whoami` terminal, reborn as static HTML.
 * Lines come from `whoami` in src/data/site.ts. The blinking cursor is pure CSS.
 */
import { site } from '../data/site';
---

<figure class="terminal" aria-label="A terminal window showing the output of whoami">
  <div class="terminal__bar" aria-hidden="true">
    <span class="terminal__dot"></span>
    <span class="terminal__dot"></span>
    <span class="terminal__dot"></span>
    <span class="terminal__title">admin@aaronlott.com: ~</span>
  </div>
  <div class="terminal__body">
    <p><span class="terminal__prompt">admin@aaronlott.com:~$</span> whoami</p>
    <dl>
      {
        site.whoami.map((line) => (
          <div>
            <dt>{line.key}:</dt>
            <dd>{line.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="terminal__done">-- [Report complete] --</p>
    <p><span class="terminal__prompt">admin@aaronlott.com:~$</span> <span class="terminal__cursor" aria-hidden="true"></span></p>
  </div>
</figure>

<style>
  .terminal {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: #161e35;
    color: var(--white-smoke);
    font-family: var(--font-mono);
    font-size: 1.4rem;
    line-height: 1.6;
    box-shadow: 14px 14px 0 var(--accent);
    /* transform: rotate(1.25deg); */
  }
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.2rem;
    background: #2c3a63;
  }
  .terminal__dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--white-smoke);
  }
  .terminal__title {
    margin-left: auto;
    margin-right: auto;
    color: var(--white-smoke);
    font-size: 1.2rem;
  }
  .terminal__body {
    padding: 1rem 1.1rem 1.2rem;
  }
  .terminal__body p { margin: 0; }
  .terminal__prompt { color: var(--accent); }
  .terminal dl { margin: 0.4rem 0 0.6rem; }
  .terminal dl > div { display: flex; gap: 0.5ch; }
  .terminal dt { color: var(--secondary); flex: none; }
  .terminal dd { margin: 0; }
  .terminal__done { opacity: 0.7; margin-bottom: 0.4rem !important; }
  .terminal__cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--white-smoke);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  /* ── Mobile: a smaller terminal ─────────────────────── */
  @media (--sm-down) {
    .terminal {
      font-size: 0.875rem;
      line-height: 1.5;
      box-shadow: 8px 8px 0 var(--accent);
    }
    .terminal__bar {
      gap: 0.3rem;
      padding: 0.4rem 0.75rem;
    }
    .terminal__dot {
      width: 0.55rem;
      height: 0.55rem;
    }
    .terminal__title {
      font-size: 0.75rem;
    }
    .terminal__body {
      padding: 0.75rem 0.8rem 0.9rem;
    }
    /* Let long values wrap under their label instead of squeezing */
    /* .terminal dl > div {
      flex-wrap: wrap;
      column-gap: 0.5ch;
    } */
  }
</style>
